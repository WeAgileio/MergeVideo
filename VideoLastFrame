#!/usr/bin/env python3
"""擷取單支影片的最後一幀並輸出 PNG。"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from extract_frame import ExtractError, extract_last_frame  # noqa: E402
from ffmpeg_utils import FFmpegError, die, require_tools  # noqa: E402
from probe import probe_video  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="VideoLastFrame",
        description="擷取單支影片的最後一幀，輸出為 {stem}_LastFrame.png",
    )
    parser.add_argument("video_file", help="輸入影片檔路徑")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    video_path = Path(args.video_file).expanduser()

    try:
        require_tools()
        video_path = video_path.resolve()
        if video_path.is_dir():
            die("請提供單一影片檔路徑，不支援資料夾輸入")
        if not video_path.exists():
            die(f"找不到檔案: {video_path}")

        probe_video(video_path)
        output_path = extract_last_frame(video_path)
        print(f"完成！輸出: {output_path}")
        return 0

    except ExtractError as exc:
        die(str(exc))
    except ValueError as exc:
        die(str(exc))
    except FFmpegError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        print("\n已取消。")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
