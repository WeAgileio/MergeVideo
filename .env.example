# === Docker Compose ===
# 專案路徑含中文，Bake 的 gRPC session 會因非 ASCII 路徑失敗，須停用
COMPOSE_BAKE=false

# === 資料庫（file/job registry）===
# 開發預設 SQLite；生產建議 PostgreSQL，例如 postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./api_data/api.db

# === Job queue（可選）===
# 設定後 worker 以 Redis 喚醒；未設定則以 DB 輪詢
REDIS_URL=redis://localhost:6379/0

# === Object Storage ===
# 啟動時以 STORAGE_BACKEND 切換：
#   local  = 本機目錄（開發用，經 /storage 靜態路由下載）
#   s3     = AWS S3 及所有 S3 相容服務（MinIO / Cloudflare R2 / 阿里 OSS / 腾讯 COS / Wasabi / B2）
#   gcs    = Google Cloud Storage（signed URL）
#   azure  = Azure Blob Storage（SAS URL）
#   rclone = 任何 rclone 支援的遠端（Google Drive / OneDrive / Dropbox / Box / Mega ...）
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./api_data/storage

# --- s3 ---
# AWS 官方服務不需設 S3_ENDPOINT_URL；其他 S3 相容服務填其 endpoint
S3_ENDPOINT_URL=http://localhost:9000
# 若 S3_ENDPOINT_URL 對外不可達（如容器內的 http://minio:9000），
# 在此填寫瀏覽器可達的位址，presigned URL 會以此端點簽名
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=mergevideo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- gcs ---
# 需 service account JSON 才能產生 signed URL；留空則用預設認證
GCS_BUCKET=mergevideo
GCS_CREDENTIALS_JSON=

# --- azure ---
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=mergevideo

# --- rclone（Google Drive / OneDrive 等）---
# 先執行 `rclone config` 建立遠端，再填「遠端名:資料夾」，例如 gdrive:mergevideo、onedrive:mergevideo
# 注意：download URL 由 `rclone link` 產生（公開分享連結，無過期時間控制）
RCLONE_REMOTE=
RCLONE_BIN=rclone

# local backend 產生 download URL 時使用的對外位址
PUBLIC_BASE_URL=http://localhost:8000

# === 認證 ===
# 逗號分隔的合法 API key 清單
API_KEYS=change-me

# === 限制與 TTL ===
MAX_FILE_SIZE_MB=200
MAX_MERGE_FILES=10
# 0 = 永不過期 / 永不清理（預設）；恢復舊行為見下方 AUTO_CLEANUP
FILE_TTL_HOURS=0
RESULT_TTL_HOURS=0
DOWNLOAD_URL_TTL_HOURS=24

# === 背景清理（預設關閉）===
# false = Worker 不自動刪除；true 且 TTL>0 時才清理
AUTO_CLEANUP_ENABLED=false
CLEANUP_INTERVAL_SECONDS=60
# 恢復舊自動清理行為範例：
# AUTO_CLEANUP_ENABLED=true
# FILE_TTL_HOURS=24
# RESULT_TTL_HOURS=72

# === CORS ===
# 逗號分隔的允許 origin，* 表示全部
CORS_ORIGINS=*

# === URL import（POST /v1/jobs/import-url）===
# 預設只允許 https；設 true 才允許 http（不建議生產環境）
IMPORT_URL_ALLOW_HTTP=false
IMPORT_URL_CONNECT_TIMEOUT_SEC=10
IMPORT_URL_TOTAL_TIMEOUT_SEC=600
IMPORT_URL_MAX_REDIRECTS=3
